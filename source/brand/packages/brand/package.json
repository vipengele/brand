{
  "name": "@vipengele/brand",
  "version": "0.1.0",
  "description": "vipengele brand kit — logo, mark and wordmark vectors plus the published raster set",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipengele/brand.git",
    "directory": "source/brand/packages/brand"
  },
  "homepage": "https://github.com/vipengele/brand/tree/main/source/brand/packages/brand#readme",
  "exports": {
    "./svg/*": "./dist/svg/*",
    "./png/*": "./dist/png/*",
    "./favicon.ico": "./dist/png/favicon.ico",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node assets/tools/build-svg.js && node assets/tools/build-png.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "opentype.js": "^2.0.0"
  }
}
